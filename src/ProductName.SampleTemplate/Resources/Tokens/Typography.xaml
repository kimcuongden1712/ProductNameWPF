    <System:Double x:Key="FontSize.Body">14</System:Double>
    <System:Double x:Key="FontSize.Caption">12</System:Double>
    <System:Double x:Key="FontSize.XSmall">10</System:Double>
    <System:Double x:Key="FontSize.Small">12</System:Double>
    <System:Double x:Key="FontSize.Middle">14</System:Double>
    <System:Double x:Key="FontSize.Large">16</System:Double>
    <System:Double x:Key="FontSize.SectionHeading">18</System:Double>
    <System:Double x:Key="FontSize.Heading">28</System:Double>
    <System:Double x:Key="FontSize.Grid">14</System:Double>
    <System:Double x:Key="FontSize.FunctionKey">14</System:Double>
</ResourceDictionary>
