<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Control.Base" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.SectionHeading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Label.Base" TargetType="{x:Type Label}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Label.XSmall" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XSmall}" />
    </Style>

    <Style x:Key="Label.Small" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="Label.Middle" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Middle}" />
    </Style>

    <Style x:Key="Label.Large" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
    </Style>

    <Style x:Key="Label.HalfWidth" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Middle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
    </Style>

    <Style x:Key="Label.Highlight" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Middle}">
        <Setter Property="Background" Value="{StaticResource Brush.LabelHighlight}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="Label.TableHeader" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Middle}">
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="Demo.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Card}" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="Demo.Code" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
