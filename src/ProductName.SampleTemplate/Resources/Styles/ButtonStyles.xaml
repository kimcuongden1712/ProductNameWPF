<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Button.Base" TargetType="{x:Type Button}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Control}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.XSmall" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XSmall}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="Button.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="Button.Middle" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Middle}" />
    </Style>

    <Style x:Key="Button.Large" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="Button.FunctionKey" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.FunctionKey}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{StaticResource Brush.FunctionKey}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.FunctionKey}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BrandPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
