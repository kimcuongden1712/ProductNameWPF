<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Input.TextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Control}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Input.TextBox.XSmall" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XSmall}" />
    </Style>

    <Style x:Key="Input.TextBox.Small" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="Input.TextBox.Middle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Middle}" />
    </Style>

    <Style x:Key="Input.TextBox.Large" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
    </Style>

    <Style x:Key="Input.TextBox.HalfWidth" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="Input.TextBox.HalfWidth2" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Middle}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="Input.CheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Input.CheckBox.Default" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Input.CheckBox}">
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="Input.RadioButton" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="Input.RadioButton.Small" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Input.RadioButton}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="Input.RadioButton.CommonWindow" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Input.RadioButton}">
        <Setter Property="Background" Value="#CCCCCC" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandHover}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.BrandPressed}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Input.ToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Control}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.LabelHighlight}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Input.ToggleButton.Small" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Input.ToggleButton}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="Input.ComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Control}" />
    </Style>

    <Style x:Key="Input.DatePicker" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
    </Style>

    <Style x:Key="Input.DatePicker.HalfWidth" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource Input.DatePicker}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
    </Style>
</ResourceDictionary>
