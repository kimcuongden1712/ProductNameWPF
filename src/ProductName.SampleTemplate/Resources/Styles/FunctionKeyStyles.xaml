<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FunctionKey.Label" TargetType="{x:Type Label}" BasedOn="{StaticResource Label.Middle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionHeading}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="FunctionKey.Button" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.FunctionKey}" />
</ResourceDictionary>
