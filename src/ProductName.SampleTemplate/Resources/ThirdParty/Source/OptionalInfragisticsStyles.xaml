                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="#00A0DE"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="FunctionKeyText" Color="#000000" />


    <!--
    **************************************************************************************************************************************
        Common Window
    **************************************************************************************************************************************
    -->
    <SolidColorBrush x:Key="CommonWindowBackground" Color="#F8FCFE" />
