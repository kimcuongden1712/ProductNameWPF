    -->
    <SolidColorBrush x:Key="CommonMainWindowBackground" Color="#F8FCFE" />
    <SolidColorBrush x:Key="CommonMainWindowBgTitle" Color="#278DA9" />
    <SolidColorBrush x:Key="CommonMainWindowFrTitle" Color="#FFFFFF" />

    <!-- Grid -->
    <!--Header-->
    <Style x:Key="CommonPopupGridHeaderArea" TargetType="{x:Type igDP:LabelPresenter}" BasedOn="{StaticResource HeaderNotHighlightedLabel}">
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Setter Property="Background" Value="#8C8B8B" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
    </Style>
    <!--Cell-->

    <Style x:Key="CommonPopupGridCellArea" TargetType="{x:Type igDP:DataRecordCellArea}">
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Setter Property="Background" Value="#525CA0"/>
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="BackgroundActive" Value="#19B5B4" />
        <Setter Property="ForegroundStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource FrListDataDefault}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Record.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="#19B5B4"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CommonPopUpTemplateGridCellValuePresenter" TargetType="{x:Type igDP:CellValuePresenter}" >
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Style.Triggers>
            <DataTrigger
            Binding="{Binding RelativeSource={RelativeSource Self}, Path=Record.IsSelected}" Value="True">
                <DataTrigger.Setters>
                    <Setter Property="ForegroundStyle">
                        <Setter.Value>
                            <Style>
                                <Setter Property="TextBlock.Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFFFFF" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ForegroundHoverStyle" >
                        <Setter.Value>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="TextElement.Foreground" 
                            Value="{Binding Path=Foreground, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordCellArea}}}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </DataTrigger.Setters>
            </DataTrigger>
            <DataTrigger
                Binding="{Binding RelativeSource={RelativeSource Self}, Path=Record.DataItem.IsSelectedTmp}" Value="True">
                <DataTrigger.Setters>
                    <Setter Property="Background" Value="#19B5B4"/>
                    <Setter Property="BorderThickness" Value="1,1,1,1" />
                    <Setter Property="ForegroundStyle">
                        <Setter.Value>
                            <Style>
                                <Setter Property="TextBlock.Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFFFFF" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ForegroundHoverStyle" >
                        <Setter.Value>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </DataTrigger.Setters>
            </DataTrigger>
            <DataTrigger Binding="{Binding Record.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="#19B5B4"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>
    <!--
    **************************************************************************************************************************************
        Common List Main Window
    **************************************************************************************************************************************
    -->
    <SolidColorBrush x:Key="CommonPopupBackground" Color="#F8FCFE" />

    <!-- Grid -->
    <!--Header-->
    <Style x:Key="CommonMainWindowGridHeaderArea" TargetType="{x:Type igDP:LabelPresenter}" BasedOn="{StaticResource HeaderNotHighlightedLabel}">
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Setter Property="Background" Value="{StaticResource BgListHeaderDefault}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
    </Style>
    <!--Cell-->
    <Style x:Key="CommonMainWindowGridCellArea" TargetType="{x:Type igDP:DataRecordCellArea}">
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Setter Property="Background" Value="{StaticResource BgListBaseBrush}"/>
        <Setter Property="BackgroundAlternate" Value="{StaticResource BgListBaseBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderListDefault}" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="ForegroundStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource FrListDataDefault}"/>
                </Style>
            </Setter.Value>
        </Setter>

        <!--Selected row color-->
        <Setter Property="BackgroundSelected" Value="Transparent" />
        <Setter Property="BorderSelectedBrush" Value="{StaticResource BorderListSelected}"/>
        <!--Active row color-->
        <Setter Property="BackgroundActive" Value="{StaticResource BgListActiveDefault}" />
        <Setter Property="BorderActiveBrush" Value="{Binding ElementName=BorderActiveBrush_Color, Path=SelectedItem}"/>
        <!--Hovered row color-->
        <Setter Property="BackgroundHover" Value="{StaticResource BgListHoverDefault}"/>
        <Setter Property="BorderHoverBrush" Value="{Binding ElementName=BorderHoverBrush_Color, Path=SelectedItem}"/>
        <Setter Property="ForegroundHoverStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="TextElement.Foreground" 
                            Value="{Binding Path=Foreground, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordCellArea}}}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ForegroundSelectedStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="TextElement.Foreground" 
                            Value="{Binding Path=Foreground, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordCellArea}}}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ForegroundActiveStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="TextElement.Foreground" 
                            Value="{Binding Path=Foreground, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordCellArea}}}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--When selected-->
            <DataTrigger Binding="{Binding Record.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource BgListActiveDefault}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderListSelected}" />
                <Setter Property="BorderThickness" Value="4,0,4,4" />
            </DataTrigger>
            <!--When the pointer is over the row-->
            <DataTrigger Binding="{Binding Record.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource BgListActiveDefault}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderListSelected}" />
                <Setter Property="BorderThickness" Value="4,0,4,4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CommonMainWindowTemplateGridCellValuePresenter" TargetType="{x:Type igDP:CellValuePresenter}" >
        <Setter Property="FontSize" Value="{StaticResource VendorFontSizeGrid}"/>
        <Style.Triggers>
            <DataTrigger
            Binding="{Binding RelativeSource={RelativeSource Self}, Path=Record.IsSelected}" Value="True">
                <DataTrigger.Setters>
                    <Setter Property="ForegroundStyle">
                        <Setter.Value>
                            <Style>
                                <Setter Property="TextBlock.Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFFFFF" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ForegroundHoverStyle" >
                        <Setter.Value>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="TextElement.Foreground" 
                            Value="{Binding Path=Foreground, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordCellArea}}}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </DataTrigger.Setters>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Record.DataItem.IsSelectedTmp}" Value="True">
                <Setter Property="Background" Value="#19B5B4"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
