<Window x:Class="ProductName.App.Wpf.Features.MainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Main" Height="720" Width="1120" MinHeight="540" MinWidth="800" WindowStartupLocation="CenterScreen" Background="#F3F5F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="Bold" Margin="4,4,4,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="SideView" FontWeight="Bold" />
                    <Button Content="MainView" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" Padding="18">
                <TextBlock Text="ContentView" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,10,0,0">
            <Button Content="F1" />
            <Button Content="F2" IsEnabled="False" />
            <Button Content="F3" IsEnabled="False" />
            <Button Content="F4" IsEnabled="False" />
            <Button Content="F5" IsEnabled="False" />
            <Button Content="F12" />
        </UniformGrid>
    </Grid>
</Window>