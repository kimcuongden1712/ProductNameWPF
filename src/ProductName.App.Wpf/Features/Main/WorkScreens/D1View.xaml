<UserControl x:Class="ProductName.App.Wpf.Features.Main.D1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#AAB3C2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="13" Padding="3">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2E8B57" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{Binding ScreenTitle}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="D1 sample form — values are retained while switching screens."
                       Margin="0,8,0,16" Foreground="SlateGray" />

            <!-- Each input is bound to D1ViewModel and tracked as unsaved form data. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Customer ID" FontWeight="SemiBold" />
                    <TextBox Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="6" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Work category (ComboBox)" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Margin="0,5,0,0" Padding="5" />
                </StackPanel>

                <CheckBox Grid.Row="1" Grid.Column="0" Content="Priority order" IsChecked="{Binding IsPriority}"
                          VerticalAlignment="Center" Margin="0,4,0,12" />
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Dispatch date (DatePicker)" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding DispatchDate, Mode=TwoWay}" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Handling mode (Radio buttons)" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton Content="Standard" GroupName="HandlingMode" IsChecked="{Binding IsStandardMode}" Margin="0,0,16,0" />
                        <RadioButton Content="Expedited" GroupName="HandlingMode" IsChecked="{Binding IsExpeditedMode}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Region (dropdown menu)" FontWeight="SemiBold" />
                    <Menu VerticalAlignment="Center" Margin="-8,3,0,0">
                        <MenuItem Header="{Binding RegionMenuHeader}">
                            <MenuItem Header="North" Command="{Binding SelectRegionCommand}" CommandParameter="North" />
                            <MenuItem Header="Central" Command="{Binding SelectRegionCommand}" CommandParameter="Central" />
                            <MenuItem Header="South" Command="{Binding SelectRegionCommand}" CommandParameter="South" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- ToggleButton is styled as a switch and remains a normal MVVM input. -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
                    <ToggleButton Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding IsAutoDispatch, Mode=TwoWay}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Automatic dispatch switch" />
                    <TextBlock Text="Automatic dispatch" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Work notes (multi-line text area)" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="110"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Margin="0,5,0,0" Padding="6" />
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="SlateGray" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
